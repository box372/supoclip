# ChunkVex AI — personal installation (one user, no paid services)
#
# Copy to .env on the server:   cp .env.personal.example .env
# Then replace every "change-me" value. Nothing below costs money.

# ── Personal mode ────────────────────────────────────────────────────────────
# No login screen, no sign-up, no billing, no social publishing.
PERSONAL_MODE=true
PERSONAL_USER_ID=personal-owner
PERSONAL_USER_EMAIL=owner@chunkvex.local
SELF_HOST=true
DISABLE_SIGN_UP=true

# ── Free video pipeline ──────────────────────────────────────────────────────
# Local Whisper transcription (no AssemblyAI key). "base" is the best
# speed/quality balance for a 4-core VM; use "tiny" for slower machines.
TRANSCRIPTION_PROVIDER=whisper
WHISPER_MODEL_SIZE=base
AI_ANALYSIS_ENABLED=false
MEDIA_STORAGE=local
BACKEND_CPU_ONLY=true
# Oracle's Always Free VM is ARM. On an x86 machine remove this line.
BACKEND_PLATFORM=linux/arm64

# ── URLs and secrets ─────────────────────────────────────────────────────────
# Public HTTPS address of your tunnel or reverse proxy.
NEXT_PUBLIC_APP_URL=https://clips.example.com
BETTER_AUTH_URL=https://clips.example.com
CORS_ORIGINS=https://clips.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000
# Generate both with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me
BACKEND_AUTH_SECRET=change-me

# ── Runtime ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=3001
FRONTEND_BUILD_TARGET=production
MAX_VIDEO_UPLOAD_BYTES=4000000000

# ── Optional: local AI (still free, CPU-only) ────────────────────────────────
# Uncomment these and start the optional Ollama container:
#   docker compose --profile ai up -d
# Then pull the model once:
#   docker compose exec ollama ollama pull qwen2.5:3b
# AI_ANALYSIS_ENABLED=true
# LLM=ollama:qwen2.5:3b
# OLLAMA_BASE_URL=http://ollama:11434
